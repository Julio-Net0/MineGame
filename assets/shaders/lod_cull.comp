#version 430 core

// Culls the LOD sections against the frame's camera and writes the indirect
// commands the LOD passes draw. One invocation per section.
//
// A section's mesh is a sequence of face runs (see RenderLodUploadMesh): quads
// of one face group, in the mesher's order. Groups 0..5 are top, bottom, -X,
// +X, +Z, -Z; group 6 is never culled by direction. A section outside the
// frustum draws nothing; inside it, an axis run whose faces all point away
// from the camera is dropped. Both tests are conservative (a margin keeps
// anything on the edge), so culling never removes a pixel: what it drops would
// have been clipped or back-face culled anyway. Kept runs that follow each
// other in the arena share one command, and the order of the quads is never
// changed, so equal-depth fragments resolve exactly as without culling.
//
// Occlusion (uPhase 1 and 2) is two-phase over the LOD depth, which already
// holds the 1:1 chunks' depth before any LOD is drawn:
//   phase 1 draws the sections that were visible last frame (PrevVisible,
//           kept per mesh, so it survives reselection; new meshes start at 1);
//   the Hi-Z pyramid is then built from the depth after phase 1;
//   phase 2 tests every section in the frustum against it: one drawn in
//           phase 1 only records the result, one not drawn is drawn now if it
//           passes. Nothing visible is ever missing from the frame: a section
//           is skipped only when the depth already in place is nearer than all
//           of it.
// uPhase 0 is the single pass without occlusion (--lod-hiz off). uPhase 3
// culls the see-through runs for the blended pass that follows the opaque
// ones: frustum, facing and, with uUseHiz, the pyramid built in phase 2,
// which never misses an occluder (its depth only grows nearer later).
//
// Positions are camera-relative and formed in integers first, exactly as in
// lod.vert, so far sections keep full precision.
//
// Two output layouts, per phase region (phase 2's starts at slot uPhaseBase):
//   uCompact true:  each pass's kept commands are packed from its region's
//                   start and counted in Counts (ARB_indirect_parameters);
//   uCompact false: a section owns one slot per run from its first slot and
//                   unused ones get instanceCount 0, for drivers without the
//                   extension.
// Opaque sections are [0, uOpaqueCount), border sections the rest; the border
// region starts uOpaqueRuns slots into the phase region in both layouts. The
// blended pass (uPhase 3) always uses a fixed list of see-through runs only.

layout(local_size_x = 64) in;

struct DrawCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    int baseVertex;
    uint baseInstance;
};

// Must match RENDER_LOD_MAX_RUNS and gl_lod.c's cull record.
const uint MAX_RUNS = 24u;
const uint RECORD_HEADER = 6u;
const uint RECORD_WORDS = RECORD_HEADER + MAX_RUNS;

// Must match gl_lod.c's COUNTER_* indices.
const uint COUNTER_DRAWS = 0u;
const uint COUNTER_FRUSTUM_CULLED = 4u;
const uint COUNTER_CANDIDATE_RUNS = 5u;
const uint COUNTER_FACING_CULLED = 6u;
const uint COUNTER_PHASE1_COMMANDS = 7u;
const uint COUNTER_PHASE1_QUADS = 8u;
const uint COUNTER_PHASE2_COMMANDS = 9u;
const uint COUNTER_PHASE2_QUADS = 10u;
const uint COUNTER_HIZ_CULLED = 11u;
const uint COUNTER_TRANSLUCENT_COMMANDS = 13u;
const uint COUNTER_TRANSLUCENT_QUADS = 14u;

// xyz: section origin in blocks; w: blocks per voxel (2^L).
layout(std430, binding = 0) readonly buffer SectionMeta {
    ivec4 Sections[];
};

// RECORD_WORDS per section: first vertex in the arena, run count, first
// command slot (opaque sections' slots first), mesh index, opaque run count
// (the runs after it are see-through faces), first slot of its see-through
// runs in the blended region, then one word per run: group << 16 | quads.
layout(std430, binding = 1) readonly buffer SectionCull {
    uint CullWords[];
};

layout(std430, binding = 2) writeonly buffer Commands {
    DrawCommand Cmds[];
};

// [0..1] phase 1 (or single pass) opaque and border draw counts, [2..3]
// phase 2's, then statistics.
layout(std430, binding = 3) buffer Counters {
    uint Counts[];
};

// Per mesh: visible when last tested. Read in phase 1, written in phase 2.
layout(std430, binding = 4) buffer Visibility {
    uint PrevVisible[];
};

layout(r32f, binding = 0) readonly uniform image2D uHiz;

uniform mat4 uViewProj;
uniform ivec3 uCameraBlock;
uniform vec3 uCameraFrac;
uniform uint uOpaqueCount;
// Command slots of the opaque sections: where the border region starts.
uniform uint uOpaqueRuns;
uniform uint uTotal;
uniform bool uCompact;
// False (--lod-cull off, a test aid) keeps every run of every section.
uniform bool uCullEnabled;
uniform int uPhase;
// First slot of this phase's command region.
uniform uint uPhaseBase;
uniform vec2 uViewport;
// Hi-Z levels 1..uHizTop; per level x: first atlas row, y: width, z: height.
uniform int uHizTop;
// Reversed-Z with an infinite far plane and a [0, 1] clip range (see
// depth_remap.frag): larger depth is nearer.
uniform bool uReversedZ;
uniform bool uUseHiz;
uniform ivec4 uHizLevels[16];

const uint AXIS_GROUPS = 6u;
const float SECTION_VOXELS = 16.0;
// In blocks: a box this far outside a plane still counts as inside it, which
// absorbs float rounding at 40000-block distances many times over.
const float FRUSTUM_MARGIN = 0.5;
// In blocks: a face direction is kept while the camera is within this
// distance of the side of the box it could be seen from.
const float FACING_MARGIN = 1.0;
// The LOD projection's near plane (gl_lod.c's LOD_NEAR_PLANE): a box corner
// this close to the camera's plane, or behind it, makes the box visible.
const float NEAR_W = 8.0;
// Window-space depth slack: a box counts as hidden only when it is farther
// than this beyond the farthest occluder depth, so neither a 24-bit 1:1 depth
// nor a 32-bit LOD depth tie can flip the result.
const float DEPTH_MARGIN = 2e-6;
// Reversed-Z keeps depth relative to distance (near / distance), so its slack
// is relative too: a box hides only beyond 1e-5 of the occluder's distance,
// a third of a block at 32768 blocks, far above float rounding there.
const float REVERSED_DEPTH_MARGIN = 1e-5;
const uint INDICES_PER_QUAD = 6u;
const uint VERTICES_PER_QUAD = 4u;

bool OutsideFrustum(vec3 boxMin, vec3 boxMax) {
    vec4 row0 = vec4(uViewProj[0][0], uViewProj[1][0], uViewProj[2][0], uViewProj[3][0]);
    vec4 row1 = vec4(uViewProj[0][1], uViewProj[1][1], uViewProj[2][1], uViewProj[3][1]);
    vec4 row2 = vec4(uViewProj[0][2], uViewProj[1][2], uViewProj[2][2], uViewProj[3][2]);
    vec4 row3 = vec4(uViewProj[0][3], uViewProj[1][3], uViewProj[2][3], uViewProj[3][3]);
    // A [-1, 1] clip range bounds z by -w..w; reversed-Z's [0, 1] range keeps
    // 0 <= z <= w, so its near plane is w - z and its far plane z.
    vec4 nearPlane = uReversedZ ? row3 - row2 : row3 + row2;
    vec4 farPlane = uReversedZ ? row2 : row3 - row2;
    vec4 planes[6] = vec4[6](row3 + row0, row3 - row0, row3 + row1,
                             row3 - row1, nearPlane, farPlane);
    for (int idx = 0; idx < 6; idx++) {
        vec4 plane = planes[idx];
        // The box corner furthest along the plane's normal.
        vec3 corner = mix(boxMin, boxMax, greaterThanEqual(plane.xyz, vec3(0.0)));
        float distance = dot(plane.xyz, corner) + plane.w;
        if (distance < -FRUSTUM_MARGIN * length(plane.xyz)) {
            return true;
        }
    }
    return false;
}

// Faces of a group lie inside the box and face one way, so all of them point
// away from a camera behind the box's opposite side.
bool FacingCamera(uint group, vec3 boxMin, vec3 boxMax) {
    switch (group) {
        case 0u: return boxMin.y < FACING_MARGIN;
        case 1u: return boxMax.y > -FACING_MARGIN;
        case 2u: return boxMax.x > -FACING_MARGIN;
        case 3u: return boxMin.x < FACING_MARGIN;
        case 4u: return boxMin.z < FACING_MARGIN;
        case 5u: return boxMax.z > -FACING_MARGIN;
        default: return true;
    }
}

// True unless the depth already drawn is nearer than every point of the box.
// The box's nearest depth is at a corner (depth grows with view distance), and
// every fragment it could produce lies inside its corners' screen rectangle,
// widened by a pixel; the pyramid level is the finest where that rectangle
// spans at most 2x2 texels.
bool HizVisible(vec3 boxMin, vec3 boxMax) {
    vec3 lo = boxMin - vec3(FRUSTUM_MARGIN);
    vec3 hi = boxMax + vec3(FRUSTUM_MARGIN);
    vec2 ndcMin = vec2(1e30);
    vec2 ndcMax = vec2(-1e30);
    float nearestZ = 1e30;
    float nearestReversed = 0.0;
    for (int corner = 0; corner < 8; corner++) {
        vec3 point = vec3(((corner & 1) != 0) ? hi.x : lo.x,
                          ((corner & 2) != 0) ? hi.y : lo.y,
                          ((corner & 4) != 0) ? hi.z : lo.z);
        vec4 clip = uViewProj * vec4(point, 1.0);
        if (clip.w <= NEAR_W) {
            return true;
        }
        vec3 ndc = clip.xyz / clip.w;
        ndcMin = min(ndcMin, ndc.xy);
        ndcMax = max(ndcMax, ndc.xy);
        nearestZ = min(nearestZ, ndc.z);
        nearestReversed = max(nearestReversed, ndc.z);
    }
    ivec2 screen = ivec2(uViewport);
    ivec2 pixelMin = ivec2(floor((ndcMin * 0.5 + 0.5) * uViewport)) - ivec2(1);
    ivec2 pixelMax = ivec2(floor((ndcMax * 0.5 + 0.5) * uViewport)) + ivec2(1);
    pixelMin = max(pixelMin, ivec2(0));
    pixelMax = min(pixelMax, screen - ivec2(1));
    if (any(greaterThan(pixelMin, pixelMax))) {
        return true;
    }
    int level = 1;
    while (level < uHizTop &&
           (((pixelMax.x >> level) - (pixelMin.x >> level)) > 1 ||
            ((pixelMax.y >> level) - (pixelMin.y >> level)) > 1)) {
        level++;
    }
    ivec4 info = uHizLevels[level];
    ivec2 first = pixelMin >> level;
    ivec2 last = min(pixelMax >> level, info.yz - ivec2(1));
    float farthest = uReversedZ ? 1.0 : 0.0;
    for (int y = first.y; y <= last.y; y++) {
        for (int x = first.x; x <= last.x; x++) {
            float texelDepth = imageLoad(uHiz, ivec2(x, info.x + y)).r;
            farthest = uReversedZ ? min(farthest, texelDepth) : max(farthest, texelDepth);
        }
    }
    if (uReversedZ) {
        return nearestReversed >= farthest * (1.0 - REVERSED_DEPTH_MARGIN);
    }
    return nearestZ * 0.5 + 0.5 <= farthest + DEPTH_MARGIN;
}

void main() {
    uint section = gl_GlobalInvocationID.x;
    if (section >= uTotal) {
        return;
    }
    ivec4 meta = Sections[section];
    uint record = section * RECORD_WORDS;
    uint firstVertex = CullWords[record];
    uint runTotal = min(CullWords[record + 1u], MAX_RUNS);
    uint firstSlot = CullWords[record + 2u];
    uint mesh = CullWords[record + 3u];
    uint opaqueRuns = min(CullWords[record + 4u], runTotal);
    // Phases 0..2 draw the opaque runs, phase 3 the see-through ones.
    bool blendedPass = uPhase == 3;
    uint firstRun = blendedPass ? opaqueRuns : 0u;
    uint endRun = blendedPass ? runTotal : opaqueRuns;
    uint blendedSlot = CullWords[record + 5u];

    vec3 boxMin = vec3(meta.xyz - uCameraBlock) - vec3(0.5) - uCameraFrac;
    vec3 boxMax = boxMin + vec3(SECTION_VOXELS * float(meta.w));
    bool inFrustum = !uCullEnabled || !OutsideFrustum(boxMin, boxMax);

    bool draw = inFrustum;
    if (uPhase == 1) {
        draw = inFrustum && PrevVisible[mesh] != 0u;
    } else if (blendedPass) {
        draw = inFrustum && (!uUseHiz || HizVisible(boxMin, boxMax));
    } else if (uPhase == 2) {
        draw = false;
        if (inFrustum) {
            bool wasDrawn = PrevVisible[mesh] != 0u;
            bool seen = HizVisible(boxMin, boxMax);
            draw = !wasDrawn && seen;
            PrevVisible[mesh] = seen ? 1u : 0u;
            if (!wasDrawn && !seen) {
                atomicAdd(Counts[COUNTER_HIZ_CULLED], 1u);
            }
        }
    }

    // Kept ranges, as (first quad, quad count).
    uvec2 ranges[MAX_RUNS];
    uint rangeCount = 0u;
    bool rangeOpen = false;
    uint start = 0u;
    uint facingCulled = 0u;
    uint drawnQuads = 0u;
    for (uint run = 0u; run < runTotal; run++) {
        uint packedRun = CullWords[record + RECORD_HEADER + run];
        uint group = packedRun >> 16u;
        uint count = packedRun & 0xFFFFu;
        if (run < firstRun || run >= endRun) {
            rangeOpen = false;
            start += count;
            continue;
        }
        bool facing = !uCullEnabled || group >= AXIS_GROUPS ||
                      FacingCamera(group, boxMin, boxMax);
        if (inFrustum && !facing) {
            facingCulled++;
        }
        if (draw && facing) {
            if (rangeOpen) {
                ranges[rangeCount - 1u].y += count;
            } else {
                ranges[rangeCount] = uvec2(start, count);
                rangeCount++;
                rangeOpen = true;
            }
            drawnQuads += count;
        } else {
            rangeOpen = false;
        }
        start += count;
    }

    bool border = section >= uOpaqueCount;
    uint regionBase = uPhaseBase + (border ? uOpaqueRuns : 0u);
    uint slot = uPhaseBase + firstSlot;
    // The blended pass keeps its fixed, dense list in both layouts: blending
    // depends on draw order, which compaction would leave to the atomics.
    if (blendedPass) {
        slot = uPhaseBase + blendedSlot;
    } else if (uCompact) {
        uint counter = COUNTER_DRAWS + (uPhase == 2 ? 2u : 0u) + (border ? 1u : 0u);
        slot = (rangeCount > 0u) ? regionBase + atomicAdd(Counts[counter], rangeCount)
                                 : 0u;
    }
    for (uint range = 0u; range < rangeCount; range++) {
        Cmds[slot + range] = DrawCommand(
            ranges[range].y * INDICES_PER_QUAD, 1u, 0u,
            int(firstVertex + ranges[range].x * VERTICES_PER_QUAD), section);
    }
    if (!uCompact || blendedPass) {
        uint ownSlots = blendedPass ? runTotal - opaqueRuns : runTotal;
        for (uint range = rangeCount; range < ownSlots; range++) {
            Cmds[slot + range] = DrawCommand(0u, 0u, 0u, 0, section);
        }
    }

    if (uPhase <= 1) {
        atomicAdd(Counts[COUNTER_CANDIDATE_RUNS], runTotal);
        if (!inFrustum) {
            atomicAdd(Counts[COUNTER_FRUSTUM_CULLED], 1u);
        }
        atomicAdd(Counts[COUNTER_FACING_CULLED], facingCulled);
    }
    uint commandsCounter = (uPhase == 2) ? COUNTER_PHASE2_COMMANDS : COUNTER_PHASE1_COMMANDS;
    uint quadsCounter = (uPhase == 2) ? COUNTER_PHASE2_QUADS : COUNTER_PHASE1_QUADS;
    if (blendedPass) {
        commandsCounter = COUNTER_TRANSLUCENT_COMMANDS;
        quadsCounter = COUNTER_TRANSLUCENT_QUADS;
    }
    atomicAdd(Counts[commandsCounter], rangeCount);
    atomicAdd(Counts[quadsCounter], drawnQuads);
}
