---
HeaderFilterRegex: 'src/.*'
# Fetched dependencies (build/_deps) and the code vendored under
# src/third_party also sit under a src/ directory, so they are excluded here to
# keep the report to the project's own code. Requires clang-tidy 19 or newer.
ExcludeHeaderFilterRegex: '.*(_deps|third_party).*'

Checks: >
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  readability-*,
  -readability-identifier-length,
  -altera-*,
  -clang-diagnostic-deprecated-declarations,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -bugprone-easily-swappable-parameters,
  -readability-function-cognitive-complexity,
  -readability-implicit-bool-conversion

CheckOptions:
  - key:             readability-identifier-naming.FunctionCase
    value:           CamelCase
  - key:             readability-identifier-naming.VariableCase
    value:           CamelCase
  - key:             readability-identifier-naming.ParameterCase
    value:           CamelCase
  - key:             readability-identifier-naming.ConstantCase
    value:           UPPER_CASE
  - key:             readability-identifier-naming.VariableMinLength
    value:           1
---
